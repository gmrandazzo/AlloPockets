[flake8]
max-line-length = 100
extend-ignore = E203, W503, E501
exclude =
    .git,
    .venv,
    notebooks,
    data,
    models,
    build,
    dist,
    __pycache__
per-file-ignores =
    predict.py: F401
    allopockets/__init__.py: F401, F403
    allopockets/database/*: F401, F403, F405, F541, F811, F841, E401, E402, E722, E731, E741, E262, E266
    allopockets/features/*: F401, F403, F405, F541, E401, E402, E722, E266, E231
    allopockets/predict.py: F401, F403, F405, F541, E401, E402, E731, E262, E266
    scripts/*: E402, F401
